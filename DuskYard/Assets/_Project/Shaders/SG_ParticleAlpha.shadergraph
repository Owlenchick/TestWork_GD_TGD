{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4f280b4f7dac4759847e00bddf3c0356",
    "m_Title": "SG_ParticleAlpha",
    "m_Content": "Shuriken-compatible HDRP Unlit particle shader. Vertex color (start color / color over lifetime) x texture x HDR tint x intensity -> Emission (nits, exposure-aware; Unlit Color would bypass exposure). Alpha is faded by scene depth difference (soft particles) to hide intersections with the ground/dummy.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1400.0,
        "y": -560.0,
